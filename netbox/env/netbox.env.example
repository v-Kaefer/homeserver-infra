# Netbox environment configuration
# Copy this file to netbox.env and update with your values

# Database configuration
DB_HOST=postgres
DB_NAME=netbox
DB_USER=netbox
DB_PASSWORD=changeme_strong_password

# Redis configuration
REDIS_HOST=redis
REDIS_CACHE_HOST=redis-cache

# Netbox configuration
SECRET_KEY=changeme_random_secret_key_min_50_chars_long_1234567890
ALLOWED_HOSTS=*

# Optional: Email configuration
# EMAIL_SERVER=smtp.example.com
# EMAIL_PORT=587
# EMAIL_USERNAME=netbox@example.com
# EMAIL_PASSWORD=password
# EMAIL_TIMEOUT=10
# EMAIL_FROM=netbox@example.com

# Optional: LDAP authentication
# AUTH_LDAP_SERVER_URI=ldap://ldap.example.com
